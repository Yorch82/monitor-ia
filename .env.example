# ════════════════════════════════════════════════════════════════════════════
#  Monitor IA — configuración (copiar a .env y editar)
#  Los cambios de Ajustes en la UI se guardan en SQLite y tienen prioridad.
# ════════════════════════════════════════════════════════════════════════════

# ── Puertos ──────────────────────────────────────────────────────────────────
APP_PORT=8080           # dashboard (acceso: http://<ip-del-servidor>:8080)
BACKEND_PORT=8000       # API + proxy OpenAI-compatible

# ── Modo de operación ────────────────────────────────────────────────────────
# true  → datos sintéticos (sin GPU ni servidor de inferencia; ideal para probar)
# false → hardware real: NVML para GPU + URL de inferencia
SIMULATION_MODE=true

# ── GPU ──────────────────────────────────────────────────────────────────────
# auto | nvidia | amd | apple | none
GPU_PROVIDER=auto

# ── Servidor de inferencia (OpenAI-compatible) ────────────────────────────────
# Ollama:    http://host.docker.internal:11434/v1
# llama.cpp: http://host.docker.internal:8080/v1
# vLLM:      http://host.docker.internal:8000/v1   (ojo al puerto del backend)
# LM Studio: http://host.docker.internal:1234/v1
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
# Métricas Prometheus (opcional; se deduce {base Sin /v1}/metrics) — llama.cpp y vLLM.
INFERENCE_METRICS_URL=
# Si tu server requiere API key (deja vacío para LM Studio/Ollama locales).
INFERENCE_API_KEY=
INFERENCE_MODEL=local-model
# Ventana de contexto si no se detecta automáticamente (Ollama/llama.cpp la detectan).
CONTEXT_WINDOW=8192
# auto | proxy | prometheus | none
TOKEN_SOURCE=auto

# ── Telemetría ───────────────────────────────────────────────────────────────
REFRESH_INTERVAL_MS=1000
HISTORY_RETENTION_HOURS=24

# ── Coste energético ─────────────────────────────────────────────────────────
KWH_PRICE_EUR=0.15

# ── Umbrales de alerta ───────────────────────────────────────────────────────
ALERT_CONTEXT_PCT=90
ALERT_GPU_TEMP_C=80
ALERT_VRAM_PCT=95
ALERT_RAM_PCT=90
ALERT_DAILY_COST_EUR=1.0

# ── Seguridad (pestaña Seguridad) ────────────────────────────────────────────
SECURITY_ENABLED=true
# Rutas DENTRO del contenedor. El compose monta /var/log del host en /host/log
# y el access log de nginx en /host/nginx. Ajusta si usas otros ficheros.
SECURITY_LOG_PATHS=/host/log/auth.log,/host/log/secure,/host/log/ufw.log,/host/nginx/security.log
SECURITY_RETENTION_HOURS=168
# Geolocalización de IPs con ip-api.com (caché SQLite; desactiva para 100% offline).
GEOIP_ENABLED=true

# ── Webhook de alertas (opcional, ej. ntfy / Slack / Discord) ─────────────────
WEBHOOK_URL=

# ── CORS (por si accedes al backend directamente desde otro origen) ──────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://192.168.1.35:8080,http://100.115.55.87:8080

# ── Parámetros de la simulación (SOLO si SIMULATION_MODE=true) ────────────────
SIM_GPU_COUNT=1
SIM_POWER_LIMIT_W=450
SIM_VRAM_TOTAL_MB=24576
SIM_RAM_TOTAL_GB=64
